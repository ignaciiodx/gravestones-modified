{
	"schemaVersion": 1,
	"id": "soulbound-gravestones",
	"version": "${version}",
	"name": "Soulbound Gravestones",
	"description": "Enhanced fork of Gravestones by Pneumono_. Adds soulbound gravestone key with teleportation, Gravestone Curse effect, complete gravestone history & recovery GUI, and enhanced Accessories integration. Original mod stores items on death in decorative gravestones.",
	"authors": [
		"IgnacioDX (Fork Author)",
		"Pneumono_ (Original Mod Author)"
	],
	"contributors": [
		"EastMonster",
		"dirtTW",
		"wouter173",
		"StarmanMine142"
	],
	"contact": {
		"homepage": "https://github.com/ignaciiodx/Soulbound-Gravestones",
		"sources": "https://github.com/ignaciiodx/Soulbound-Gravestones",
		"issues": "https://github.com/ignaciiodx/Soulbound-Gravestones/issues"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/your-discord-here",
				"modmenu.modrinth.original": "https://modrinth.com/project/Heh3BbSv"
			},
			"badges": ["library"]
		}
	},
	"license": "MIT",
	"icon": "assets/gravestones/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.pneumono.gravestones.Gravestones"
		],
		"client": [
			"net.pneumono.gravestones.GravestonesClient"
		],
		"modmenu": [
			"net.pneumono.gravestones.compat.ModMenuCompat"
		]
	},
	"mixins": [
		"gravestones.mixins.json",
		{
			"config": "gravestones.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "gravestones.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": ">=1.21 <=1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"pneumonocore": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
